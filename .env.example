# 复制为 .env.local 后填入实际值

# ─── AI 推理（OpenAI 兼容协议）───
# 默认对接 z.ai Coding Plan（GLM 系列），三个变量都可覆盖：
#   AI_BASE_URL  默认 https://api.z.ai/api/coding/paas/v4
#   AI_API_KEY   必填（也可用环境变量 ZAI_API_KEY 代替）
#   AI_MODEL     默认 glm-5.3-flash，可改 glm-5.3 等
# 未设 AI_API_KEY/ZAI_API_KEY 时回退 DEEPSEEK_API_KEY（deepseek-chat）。
AI_API_KEY=your-api-key
# AI_BASE_URL=https://api.z.ai/api/coding/paas/v4
# AI_MODEL=glm-5.3-flash

# ─── 站点 ───
NEXT_PUBLIC_SITE_URL=http://localhost:3000
